generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  snippets    Snippet[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Snippet {
  id           String     @id @default(cuid())
  title        String
  description  String?
  code         String     @db.Text
  language     String
  tags         String[]   @default([])
  isFavorite   Boolean    @default(false)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId])
  @@index([language])
  @@index([isFavorite])
}
